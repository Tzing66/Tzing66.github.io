---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { site, about, experience, education, projects, stack, currently, contact } from "../content/site.config";

const card = "rounded-xl border border-line bg-surface p-5";
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />

    <Section id="about">
      <div class="max-w-2xl space-y-4 text-lg text-muted">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <ul class="mt-8 flex flex-wrap gap-2">
        {about.facts.map((f) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{f}</li>)}
      </ul>
    </Section>

    <Section id="experience">
      <ol class="space-y-4">
        {
          experience.map((job) => (
            <li class={card}>
              <p class="font-mono text-xs text-muted">{job.period}{job.location && ` · ${job.location}`}</p>
              <h3 class="mt-1 text-lg font-semibold">{job.role}</h3>
              <p class="text-muted">{job.company}</p>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
      <h3 class="mt-12 mb-4 font-mono text-xs tracking-wide text-muted">Education</h3>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          education.map((e) => (
            <li class={card}>
              <p class="font-semibold">{e.degree}</p>
              <p class="text-sm text-muted">{e.school}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="projects">
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          projects.map((p) => (
            <li class={card}>
              <h3 class="text-lg font-semibold">{p.title ?? p.repo}</h3>
              <p class="mt-1 text-sm text-muted">{p.tagline}</p>
              <a href={`https://github.com/${p.repo}`} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-mono text-xs text-accent-ink hover:underline">
                {p.repo}
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="stack">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          stack.map((g) => (
            <div class={card}>
              <h3 class="mb-3 font-mono text-xs tracking-wide text-muted">{g.group}</h3>
              <ul class="flex flex-wrap gap-2">
                {g.items.map((i) => <li class="rounded-md border border-line px-2.5 py-1 text-sm">{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="now">
      <div class={card}>
        <h3 class="mb-3 font-mono text-xs tracking-wide text-muted">Currently</h3>
        <ul class="space-y-1">{currently.map((c) => <li>{c}</li>)}</ul>
      </div>
    </Section>

    <Section id="contact">
      <p class="max-w-xl text-lg text-muted">{contact.blurb}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 font-medium text-on-accent">
          <Icon name="linkedin" /> LinkedIn
        </a>
        <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-5 py-3 font-medium hover:border-accent">
          <Icon name="github" /> GitHub
        </a>
        <a href={site.links.resume} download class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-5 py-3 font-medium hover:border-accent">
          <Icon name="download" /> Resume
        </a>
      </div>
    </Section>
  </main>
  <Footer />
</Layout>
