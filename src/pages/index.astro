---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import StackGrid from "../components/StackGrid.astro";
import Contact from "../components/Contact.astro";
import ProgressRail from "../components/ProgressRail.astro";
import NowGrid from "../components/NowGrid.astro";
import BackToTop from "../components/BackToTop.astro";
import CommandPalette from "../components/CommandPalette.tsx";
import { about, sections, projects, site } from "../content/site.config";
---

<Layout>
  <Nav />
  <ProgressRail />
  <main id="main">
    <Hero />

    <Section id="about">
      {
        about.paragraphs.length > 0 && (
          <div data-stagger class="max-w-2xl space-y-4 text-lg text-muted">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        )
      }
      <ul data-stagger class="mt-8 flex flex-wrap gap-2">
        {about.facts.map((f) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{f}</li>)}
      </ul>
    </Section>

    <Section id="experience">
      <Timeline />
    </Section>

    <Section id="projects">
      <Projects />
    </Section>

    <Section id="stack">
      <StackGrid />
    </Section>

    <Section id="now">
      <NowGrid />
    </Section>

    <Section id="contact">
      <Contact />
    </Section>
  </main>
  <Footer />
  <BackToTop />
  <CommandPalette
    client:idle
    sections={sections.map(({ id, label }) => ({ id, label }))}
    projects={projects.map((p) => ({ slug: p.slug, title: p.title ?? p.repo }))}
    links={site.links}
    email={site.email}
  />
</Layout>
