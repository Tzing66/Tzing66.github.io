---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import StackGrid from "../components/StackGrid.astro";
import Contact from "../components/Contact.astro";
import ProgressRail from "../components/ProgressRail.astro";
import { about, currently } from "../content/site.config";

const card = "rounded-xl border border-line bg-surface p-5";
---

<Layout>
  <Nav />
  <ProgressRail />
  <main id="main">
    <Hero />

    <Section id="about">
      {
        about.paragraphs.length > 0 && (
          <div data-stagger class="max-w-2xl space-y-4 text-lg text-muted">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        )
      }
      <ul data-stagger class="mt-8 flex flex-wrap gap-2">
        {about.facts.map((f) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{f}</li>)}
      </ul>
    </Section>

    <Section id="experience">
      <Timeline />
    </Section>

    <Section id="projects">
      <Projects />
    </Section>

    <Section id="stack">
      <StackGrid />
    </Section>

    <Section id="now">
      <div data-reveal class={card}>
        <h3 class="mb-3 font-mono text-xs tracking-wide text-muted">Currently</h3>
        <ul class="space-y-1">{currently.map((c) => <li>{c}</li>)}</ul>
      </div>
    </Section>

    <Section id="contact">
      <Contact />
    </Section>
  </main>
  <Footer />
</Layout>
