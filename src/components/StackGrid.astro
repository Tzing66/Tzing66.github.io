---
import { stack } from "../content/site.config";
import { techIcon } from "../lib/icons";
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    stack.map((g) => (
      <div class="rounded-xl border border-line bg-surface p-5">
        <h3 class="mb-4 font-mono text-xs tracking-wide text-muted">{g.group}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.items.map((name) => {
            const icon = techIcon(name);
            return (
              <li class="group inline-flex items-center gap-2 rounded-lg border border-line bg-bg px-3 py-2 text-sm transition-colors hover:border-accent">
                {icon ? (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" class="text-muted transition-colors group-hover:text-accent-ink">
                    <path d={icon.path} />
                  </svg>
                ) : (
                  // No logo available (e.g. AWS): a small accent node keeps the row aligned.
                  <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                )}
                {name}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
