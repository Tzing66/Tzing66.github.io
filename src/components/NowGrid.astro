---
// Bento grid for the Now section. Cards with no data simply don't render.
import MusicCard from "./MusicCard.astro";
import GithubActivity from "./GithubActivity.astro";
import { currently, nowExtras } from "../content/site.config";
import { music } from "../lib/music";
import { activity } from "../lib/github";

const card = "rounded-xl border border-line bg-surface p-5";
const hasActivity = !!activity && (activity.days.length > 0 || !!activity.lastPush);
---

<div data-stagger class="grid gap-4 lg:grid-cols-3">
  {music && <MusicCard class="lg:row-span-2" />}
  {hasActivity && <GithubActivity class="lg:col-span-2" />}

  {
    currently.length > 0 && (
      <article class:list={[card, music && nowExtras.length === 0 && "lg:col-span-2"]}>
        <h3 class="mb-3 font-mono text-xs tracking-wide text-muted">Currently</h3>
        <ul class="space-y-1.5 text-sm">
          {currently.map((c) => (
            <li class="flex gap-2">
              <span class="text-accent-ink">›</span>
              {c}
            </li>
          ))}
        </ul>
      </article>
    )
  }

  {
    nowExtras.map((x) => (
      <article class={card}>
        <h3 class="mb-3 font-mono text-xs tracking-wide text-muted">{x.label}</h3>
        {x.href ? (
          <a href={x.href} target="_blank" rel="noopener noreferrer" class="font-medium hover:text-accent-ink">
            {x.title}
          </a>
        ) : (
          <p class="font-medium">{x.title}</p>
        )}
        {x.text && <p class="mt-1 text-sm text-muted">{x.text}</p>}
      </article>
    ))
  }
</div>
