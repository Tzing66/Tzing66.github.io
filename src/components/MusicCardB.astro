---
// Spotify card, layout B: a two-column hero (big art on a blurred wash of the same art) above
// recently played and top artists / on repeat. Same data-* hooks as MusicCard, so the shared
// live script (src/lib/music-live.ts) drives it identically.
import { music } from "../lib/music";
import { music as musicConfig } from "../content/site.config";
import { timeAgo } from "../lib/time";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const m = music!;
const [last, ...recent] = m.recent;
const spotifyLogo =
  "M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm5.5 17.3a.75.75 0 0 1-1 .25c-2.8-1.7-6.4-2.1-10.6-1.2a.75.75 0 1 1-.33-1.46c4.6-1 8.6-.6 11.7 1.4.36.2.47.68.25 1.02Zm1.47-3.27a.94.94 0 0 1-1.29.31c-3.2-2-8.1-2.55-11.9-1.4a.94.94 0 0 1-.55-1.8c4.3-1.3 9.7-.68 13.4 1.6.44.27.58.85.31 1.29Zm.13-3.4C15.2 8.3 8.8 8.1 5.1 9.2a1.13 1.13 0 1 1-.66-2.16c4.25-1.3 11.3-1.04 15.8 1.6a1.13 1.13 0 0 1-1.14 1.96Z";
const thumb = "rounded border border-line object-cover";
---

<article
  data-music
  data-now-url={musicConfig.nowPlayingUrl}
  data-poll={musicConfig.pollSeconds}
  class:list={["flex flex-col overflow-hidden rounded-xl border border-line bg-surface", className]}
>
  <!-- Hero -->
  <div class="relative overflow-hidden">
    <img data-hero-bg src={last?.image ?? ""} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full scale-125 object-cover opacity-25 blur-3xl" />
    <div class="relative flex items-center justify-between px-6 pt-5">
      <h3 class="flex items-center gap-2 font-mono text-xs tracking-wide text-muted">
        <span class="eq" data-eq hidden aria-hidden="true"><i></i><i></i><i></i></span>
        <span data-heading>Last played</span>
      </h3>
      <a href={m.profile} target="_blank" rel="noopener noreferrer" class="relative flex items-center gap-1.5 font-mono text-[11px] text-muted hover:text-fg">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="#1DB954" aria-hidden="true"><path d={spotifyLogo} /></svg>
        <span data-badge>spotify ↗</span>
      </a>
    </div>
    <a data-hero href={last?.url} target="_blank" rel="noopener noreferrer" class="group relative grid items-center gap-5 p-6 sm:grid-cols-[160px_1fr]" aria-live="polite">
      <img data-hero-img src={last?.image ?? ""} alt="" width="160" height="160" loading="lazy" decoding="async" class="size-32 rounded-xl border border-line bg-bg object-cover shadow-2xl sm:size-40" />
      <span class="min-w-0">
        <span data-hero-title class="block truncate text-2xl font-semibold tracking-tight group-hover:text-accent-ink sm:text-3xl">{last?.title}</span>
        <span data-hero-artist class="block truncate text-muted">{last?.artist}</span>
        <span data-hero-album class="block truncate text-sm text-muted/70">{last?.album}</span>
        <span data-progress-wrap hidden class="mt-4 block">
          <span class="block h-1 overflow-hidden rounded-full bg-line"><span data-progress class="block h-full w-0 rounded-full bg-accent"></span></span>
          <span class="mt-1 flex justify-between font-mono text-[10px] text-muted"><span data-elapsed>0:00</span><span data-duration>0:00</span></span>
        </span>
        <span data-hero-when class="mt-3 block font-mono text-[11px] text-muted">
          {last?.playedAt && <time data-ago datetime={last.playedAt}>{timeAgo(last.playedAt)}</time>}
        </span>
      </span>
    </a>
  </div>

  <div class="grid gap-6 border-t border-line p-6 sm:grid-cols-2">
    {
      recent.length > 0 && (
        <div>
          <h4 class="mb-3 font-mono text-xs tracking-wide text-muted">Recently played</h4>
          <ol data-recent class="space-y-2.5">
            {recent.slice(0, 4).map((t) => (
              <li>
                <a href={t.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3">
                  <img src={t.image ?? ""} alt="" width="36" height="36" loading="lazy" decoding="async" class:list={["size-9 shrink-0", thumb]} />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm group-hover:text-accent-ink">{t.title}</span>
                    <span class="block truncate text-xs text-muted">{t.artist}</span>
                  </span>
                  <span class="shrink-0 font-mono text-[11px] text-muted">
                    {t.playedAt && <time data-ago datetime={t.playedAt}>{timeAgo(t.playedAt)}</time>}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
    <div>
      {
        m.topArtists.length > 0 && (
          <>
            <h4 class="mb-3 font-mono text-xs tracking-wide text-muted">Top artists this month</h4>
            <ul class="grid grid-cols-4 gap-3">
              {m.topArtists.slice(0, 4).map((a) => (
                <li>
                  <a href={a.url} target="_blank" rel="noopener noreferrer" class="group block text-center">
                    <img src={a.image ?? ""} alt="" width="72" height="72" loading="lazy" decoding="async" class="mx-auto aspect-square w-full rounded-full border border-line object-cover transition-transform group-hover:scale-105" />
                    <span class="mt-1.5 block truncate text-xs text-muted group-hover:text-fg">{a.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        m.topTracks.length > 0 && (
          <>
            <h4 class="mt-5 mb-3 font-mono text-xs tracking-wide text-muted">On repeat</h4>
            <ul class="grid grid-cols-5 gap-2">
              {m.topTracks.slice(0, 5).map((t) => (
                <li>
                  <a href={t.url} target="_blank" rel="noopener noreferrer" title={`${t.title} · ${t.artist}`} class="block">
                    <img src={t.image ?? ""} alt={`${t.title} by ${t.artist}`} width="64" height="64" loading="lazy" decoding="async" class:list={["aspect-square w-full transition-transform hover:scale-105", thumb]} />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>

  <p class="border-t border-line px-6 py-3 font-mono text-[11px] text-muted" data-footnote>
    snapshot · updated <time data-ago datetime={m.fetchedAt}>{timeAgo(m.fetchedAt)}</time>
  </p>
</article>

<script>
  import { initMusicLive } from "../lib/music-live";
  initMusicLive();
</script>
