---
import Icon from "./Icon.astro";
import { site } from "../content/site.config";
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p><span class="text-accent-ink">●</span> all systems operational</p>
    <p>Built with Astro · deployed on GitHub Pages · © {year} {site.name}</p>
    <div class="flex gap-1">
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="grid size-9 place-items-center rounded-md hover:text-fg">
        <Icon name="github" size={16} />
      </a>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid size-9 place-items-center rounded-md hover:text-fg">
        <Icon name="linkedin" size={16} />
      </a>
    </div>
  </div>
</footer>
