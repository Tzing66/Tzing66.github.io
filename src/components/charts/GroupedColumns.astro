---
// Grouped columns (two series per group) in plain HTML/CSS: ≤24px columns, 4px rounded
// caps square at the baseline, 2px surface gap between neighbours. Only the largest value
// is labelled on its cap; every column has a hover/focus tooltip, and "full" adds a table.
interface Props {
  data: {
    title: string;
    subtitle?: string;
    unit: string;
    source?: string;
    note?: string;
    series: { key: string; label: string }[];
    groups: ({ label: string } & Record<string, number | string>)[];
  };
  variant?: "card" | "full";
}
const { data, variant = "card" } = Astro.props;
const colors = ["var(--series-1)", "var(--series-2)"];
const values = data.groups.flatMap((g) => data.series.map((s) => Number(g[s.key])));
const max = Math.max(...values);
const step = 10000;
const yMax = Math.ceil(max / step) * step;
const ticks = Array.from({ length: yMax / step + 1 }, (_, i) => i * step);
const fmt = (v: number) => Math.round(v).toLocaleString("en-US");
const fmtK = (v: number) => (v === 0 ? "0" : `${v / 1000}k`);
const full = variant === "full";
---

<figure class="flex h-full flex-col" data-columns>
  <figcaption class="mb-3">
    <p class="text-sm font-medium text-fg">{data.title}</p>
    {data.subtitle && <p class="text-xs text-muted">{data.subtitle}</p>}
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted" aria-label="Legend">
      {
        data.series.map((s, i) => (
          <li class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-[3px]" style={`background:${colors[i]}`} aria-hidden="true" />
            {s.label}
          </li>
        ))
      }
    </ul>
  </figcaption>

  <div class:list={["relative flex-1 pb-6 pl-8", full ? "min-h-56" : "min-h-40"]}>
    {
      ticks.map((v) => (
        <div class="pointer-events-none absolute right-0 left-8" style={`bottom:calc(1.5rem + (100% - 1.5rem) * ${v / yMax})`} aria-hidden="true">
          <div class="h-px bg-line" />
          <span class="absolute -top-2 -left-8 w-7 text-right font-mono text-[10px] text-muted tabular-nums">{fmtK(v)}</span>
        </div>
      ))
    }

    <div class="absolute inset-0 bottom-6 left-8 flex items-end justify-around">
      {
        data.groups.map((g) => (
          <div class="relative flex h-full items-end gap-0.5">
            {data.series.map((s, i) => {
              const v = Number(g[s.key]);
              const isMax = v === max;
              return (
                <div
                  class="group/bar relative w-6 rounded-t-[4px] outline-none transition-[filter] hover:brightness-110 focus-visible:ring-2 focus-visible:ring-fg/60"
                  style={`height:${(v / yMax) * 100}%;background:${colors[i]}`}
                  tabindex="0"
                  role="img"
                  aria-label={`${s.label}, ${g.label}: ${fmt(v)} ${data.unit}`}
                >
                  {isMax && (
                    <span class="absolute -top-5 left-1/2 -translate-x-1/2 font-mono text-[11px] whitespace-nowrap text-fg tabular-nums" aria-hidden="true">
                      {fmt(v)}
                    </span>
                  )}
                  <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-1.5 hidden -translate-x-1/2 rounded-md border border-line bg-surface/95 px-2.5 py-1.5 text-xs whitespace-nowrap shadow-lg backdrop-blur group-hover/bar:block group-focus-visible/bar:block">
                    <span class="block font-semibold text-fg tabular-nums">{fmt(v)} t</span>
                    <span class="flex items-center gap-1.5 text-muted">
                      <span class="h-0.5 w-3 rounded-full" style={`background:${colors[i]}`} />
                      {s.label} · {g.label}
                    </span>
                  </span>
                </div>
              );
            })}
            <span class="absolute -bottom-5 left-1/2 -translate-x-1/2 font-mono text-[10px] whitespace-nowrap text-muted">{g.label}</span>
          </div>
        ))
      }
    </div>
  </div>

  {
    full && (
      <details class="mt-3 text-xs text-muted">
        <summary class="cursor-pointer font-mono text-[11px] hover:text-fg">Data table</summary>
        <table class="mt-2 w-full font-mono text-[11px] tabular-nums">
          <thead>
            <tr class="text-left text-fg">
              <th class="py-1 font-medium">Scenario</th>
              {data.series.map((s) => <th class="py-1 text-right font-medium">{s.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {data.groups.map((g) => (
              <tr class="border-t border-line">
                <td class="py-1">{g.label}</td>
                {data.series.map((s) => <td class="py-1 text-right">{fmt(Number(g[s.key]))}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-2">Unit: {data.unit}.{data.note && ` ${data.note}`}</p>
      </details>
    )
  }
</figure>
