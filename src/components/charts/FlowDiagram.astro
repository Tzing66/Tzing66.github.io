---
// A project's pipeline as stacked nodes with connectors, in the hero DAG's style.
// A dot travels each connector in sequence (CSS only; hidden under reduced motion).
interface Props {
  steps: string[];
  title: string;
}
const { steps, title } = Astro.props;
const period = steps.length * 0.7; // seconds for one pass through the whole pipeline
---

<ol class="flow flex flex-col items-center" aria-label={`${title} pipeline`} style={`--period:${period}s`}>
  {
    steps.map((s, i) => (
      <li class="flex flex-col items-center">
        {i > 0 && (
          <span class="flow-edge relative block h-5 w-px bg-line" style={`--delay:${(i - 1) * 0.7}s`} aria-hidden="true" />
        )}
        <span class:list={["rounded-lg border px-3 py-1.5 font-mono text-[11px] whitespace-nowrap", i === steps.length - 1 ? "border-accent/60 bg-bg text-fg" : "border-line bg-surface text-fg"]}>
          <span class="mr-1.5 text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
          {s}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .flow-edge::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 9999px;
    background: var(--accent);
    opacity: 0;
    animation: flow-dot var(--period) linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes flow-dot {
    0% { transform: translateY(-2px); opacity: 0; }
    3% { opacity: 1; }
    13% { opacity: 1; }
    16% { transform: translateY(18px); opacity: 0; }
    100% { transform: translateY(18px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-edge::after { display: none; }
  }
</style>
