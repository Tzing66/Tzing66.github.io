---
// Renders its slot with every id (and same-page #anchor) prefixed. Markdown write-ups get
// automatic heading ids like "stack" or "results"; unprefixed, they'd collide with page
// sections (#stack) and with each other, breaking anchor links.
interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
const html = (await Astro.slots.render("default"))
  .replace(/\sid="([^"]+)"/g, ` id="${prefix}-$1"`)
  .replace(/\shref="#([^"]+)"/g, ` href="#${prefix}-$1"`);
---

<Fragment set:html={html} />
