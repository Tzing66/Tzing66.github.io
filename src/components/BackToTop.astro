<!-- Appears once the hero is out of view (IntersectionObserver, no scroll listener). -->
<a
  href="#home"
  id="back-to-top"
  aria-label="Back to top"
  class="fixed right-4 bottom-4 z-40 grid size-10 translate-y-2 place-items-center rounded-full border border-line bg-surface/90 text-muted opacity-0 backdrop-blur transition-[opacity,transform] duration-200 hover:border-accent hover:text-fg data-[show]:translate-y-0 data-[show]:opacity-100 sm:right-6 sm:bottom-6"
  tabindex="-1"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6"></path>
  </svg>
</a>

<script>
  const btn = document.getElementById("back-to-top")!;
  const hero = document.getElementById("home");
  if (hero) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting;
      btn.toggleAttribute("data-show", show);
      // Hidden control shouldn't be a tab stop.
      btn.tabIndex = show ? 0 : -1;
      btn.setAttribute("aria-hidden", String(!show));
    }).observe(hero);
  }
</script>
