# Copy to .env (git-ignored) for local fetches. In CI these come from GitHub Actions secrets.
# Spotify app credentials (developer.spotify.com/dashboard → your app → Settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written by `npm run spotify:auth`; expires 6 months after you authorize, then re-run it.
SPOTIFY_REFRESH_TOKEN=
# Optional locally: enables the contribution heatmap fetch (e.g. GITHUB_TOKEN=$(gh auth token)).
GITHUB_TOKEN=
